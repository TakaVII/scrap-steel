[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/UI/job_panel.gd" id="1_job"]

[node name="JobPanel" type="PanelContainer"]
script = ExtResource("1_job")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 3
theme_override_constants/margin_top = 3
theme_override_constants/margin_right = 3
theme_override_constants/margin_bottom = 3

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="ChampionBanner" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.992, 0.682, 0.38, 1)
text = "CHAMPION_BANNER"
horizontal_alignment = 1
clip_text = true

[node name="HeaderLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Job"
clip_text = true

[node name="StatsLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.992, 0.682, 0.38, 1)
text = "Stats"
clip_text = true

[node name="PreviewHolder" type="CenterContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="ChampionRow" type="HBoxContainer" parent="Margin/VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 6

[node name="ChampionStatus" type="Label" parent="Margin/VBox/ChampionRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Status"
autowrap_mode = 3
max_lines_visible = 2

[node name="RegisterButton" type="Button" parent="Margin/VBox/ChampionRow"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(110, 20)
layout_mode = 2
size_flags_vertical = 4
text = "CHAMPION_REGISTER"

[node name="PartsRow" type="HFlowContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 4
theme_override_constants/v_separation = 2
