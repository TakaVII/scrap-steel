[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/UI/workshop_screen.gd" id="1_workshop"]

[node name="WorkshopScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_workshop")

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ApDisplayLabel" type="Label" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
text = "Workshop Active | Available AP: 6 / 6"

[node name="StatusInfoLabel" type="Label" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
text = "Phase 1 Workshop loop. Click 'Fabricate Part' to spend 2 AP and simulate delivery."

[node name="HSeparator" type="HSeparator" parent="MarginContainer/VBoxContainer"]
layout_mode = 2

[node name="HBoxActions" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="CompletePartButton" type="Button" parent="MarginContainer/VBoxContainer/HBoxActions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 44)
layout_mode = 2
text = "WORKSHOP_FABRICATE_PART"

[node name="OvertimeButton" type="Button" parent="MarginContainer/VBoxContainer/HBoxActions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(140, 44)
layout_mode = 2
text = "WORKSHOP_OVERTIME"

[node name="Spacer" type="Control" parent="MarginContainer/VBoxContainer/HBoxActions"]
layout_mode = 2
size_flags_horizontal = 3

[node name="EndDayButton" type="Button" parent="MarginContainer/VBoxContainer/HBoxActions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 44)
layout_mode = 2
text = "WORKSHOP_END_DAY"

[connection signal="pressed" from="MarginContainer/VBoxContainer/HBoxActions/CompletePartButton" to="." method="_on_complete_part_button_pressed"]
[connection signal="pressed" from="MarginContainer/VBoxContainer/HBoxActions/OvertimeButton" to="." method="_on_overtime_button_pressed"]
[connection signal="pressed" from="MarginContainer/VBoxContainer/HBoxActions/EndDayButton" to="." method="_on_end_day_button_pressed"]
