[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/UI/workshop_screen.gd" id="1_workshop"]

[node name="WorkshopScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_workshop")

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="HBoxTop" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]
layout_mode = 2

[node name="ApDisplayLabel" type="Label" parent="MarginContainer/VBoxContainer/HBoxTop"]
unique_name_in_owner = true
layout_mode = 2
text = "Workshop Active | Available AP: 6 / 6"

[node name="Spacer" type="Control" parent="MarginContainer/VBoxContainer/HBoxTop"]
layout_mode = 2
size_flags_horizontal = 3

[node name="OvertimeButton" type="Button" parent="MarginContainer/VBoxContainer/HBoxTop"]
unique_name_in_owner = true
layout_mode = 2
text = "WORKSHOP_OVERTIME"

[node name="EndDayButton" type="Button" parent="MarginContainer/VBoxContainer/HBoxTop"]
unique_name_in_owner = true
layout_mode = 2
text = "WORKSHOP_END_DAY"

[node name="HSeparator" type="HSeparator" parent="MarginContainer/VBoxContainer"]
layout_mode = 2

[node name="ScrollContainer" type="ScrollContainer" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3

[node name="ActiveJobsContainer" type="VBoxContainer" parent="MarginContainer/VBoxContainer/ScrollContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="StatusInfoLabel" type="Label" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
text = "Click an active part above to spend AP and fabricate components."

[connection signal="pressed" from="MarginContainer/VBoxContainer/HBoxTop/OvertimeButton" to="." method="_on_overtime_button_pressed"]
[connection signal="pressed" from="MarginContainer/VBoxContainer/HBoxTop/EndDayButton" to="." method="_on_end_day_button_pressed"]
