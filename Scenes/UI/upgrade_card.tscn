[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/UI/upgrade_card.gd" id="1_upg_card"]

[node name="UpgradeCard" type="PanelContainer"]
custom_minimum_size = Vector2(260, 110)
offset_right = 260.0
offset_bottom = 110.0
script = ExtResource("1_upg_card")

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 6

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="HBoxTop" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]
layout_mode = 2

[node name="TitleLabel" type="Label" parent="MarginContainer/VBoxContainer/HBoxTop"]
unique_name_in_owner = true
layout_mode = 2
text = "Supplier Network"

[node name="Spacer" type="Control" parent="MarginContainer/VBoxContainer/HBoxTop"]
layout_mode = 2
size_flags_horizontal = 3

[node name="CostLabel" type="Label" parent="MarginContainer/VBoxContainer/HBoxTop"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.992, 0.682, 0.380, 1)
text = "800 cr | 2 TP"

[node name="DescLabel" type="Label" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
text = "-10% material cost on all components"
autowrap_mode = 3

[node name="PaybackLabel" type="Label" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.168, 0.513, 0.729, 1)
text = "Pays for itself in ~6.6 days"

[node name="DebtCompareLabel" type="Label" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
text = "Debt interest costs you 200 cr/day"

[node name="BuyButton" type="Button" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
text = "UPG_PURCHASE"

[connection signal="pressed" from="MarginContainer/VBoxContainer/BuyButton" to="." method="_on_buy_button_pressed"]
