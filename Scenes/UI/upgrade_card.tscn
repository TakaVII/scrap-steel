[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/UI/upgrade_card.gd" id="1_upg_card"]

[node name="UpgradeCard" type="PanelContainer"]
script = ExtResource("1_upg_card")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 5
theme_override_constants/margin_top = 3
theme_override_constants/margin_right = 5
theme_override_constants/margin_bottom = 3

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 1

[node name="HBoxTop" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="TitleLabel" type="Label" parent="Margin/VBox/HBoxTop"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Upgrade"
clip_text = true

[node name="BuyButton" type="Button" parent="Margin/VBox/HBoxTop"]
unique_name_in_owner = true
custom_minimum_size = Vector2(54, 18)
layout_mode = 2
text = "UPG_BUY"

[node name="DescLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = ""
clip_text = true

[node name="CostRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="CostLabel" type="Label" parent="Margin/VBox/CostRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.992, 0.682, 0.38, 1)
text = "800 cr | 2 TP"

[node name="PaybackLabel" type="Label" parent="Margin/VBox/CostRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.168, 0.513, 0.729, 1)
text = ""
clip_text = true

[node name="DebtCompareLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = ""
clip_text = true

[connection signal="pressed" from="Margin/VBox/HBoxTop/BuyButton" to="." method="_on_buy_button_pressed"]
