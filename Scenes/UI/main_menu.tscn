[gd_scene load_steps=2 format=3 uid="uid://c6mainmenu"]

[ext_resource type="Script" path="res://Scripts/UI/main_menu.gd" id="1_script"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(220, 0)
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "SCRAP & STEEL"
horizontal_alignment = 1

[node name="SubtitleLabel" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.992, 0.682, 0.380, 1.0)
text = "[◆] ASTRA CITY GARAGE"
horizontal_alignment = 1

[node name="NewGameButton" type="Button" parent="Center/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "MENU_NEW_GAME"

[node name="ContinueButton" type="Button" parent="Center/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "MENU_CONTINUE"

[node name="SettingsButton" type="Button" parent="Center/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "MENU_SETTINGS"

[connection signal="pressed" from="Center/VBox/NewGameButton" to="." method="_on_new_game_button_pressed"]
[connection signal="pressed" from="Center/VBox/ContinueButton" to="." method="_on_continue_button_pressed"]
[connection signal="pressed" from="Center/VBox/SettingsButton" to="." method="_on_settings_button_pressed"]
